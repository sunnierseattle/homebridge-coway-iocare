{
  "name": "homebridge-coway-iocare",
  "displayName": "Coway Airmega",
  "version": "1.2.1",
  "description": "Homebridge plugin for WiFi-connected Coway Airmega air purifiers via the IoCare cloud API.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "keywords": [
    "homebridge-plugin",
    "coway",
    "airmega",
    "iocare",
    "air-purifier"
  ],
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@homebridge/hap-nodejs": "^2.2.3",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.3.0",
    "homebridge": "^2.0.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^5.0.0"
  },
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "author": "sunnierseattle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunnierseattle/homebridge-coway-iocare.git"
  },
  "bugs": {
    "url": "https://github.com/sunnierseattle/homebridge-coway-iocare/issues"
  },
  "homepage": "https://github.com/sunnierseattle/homebridge-coway-iocare#readme"
}
